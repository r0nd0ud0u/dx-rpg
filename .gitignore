# Generated by Cargo
# will have compiled files and executables
/target
.DS_Store

# These are backup files generated by rustfmt
**/*.rs.bk

/node_modules/*

# games output
saved_data/*

# bundle output defined in dioxus.toml [application] / out_dir
/bundle/*

# desktop/mobile client bundle output (scripts/bundle_desktop.sh, scripts/bundle_mobile.sh)
/bundle-desktop/*
/bundle-android/*
/bundle-android-aab/*
/bundle-ios/*
/db.sqlite-journal

# CI-decoded release signing keystore (build-android-aab job in
# bundle_to_asset.yml) — never the real production keystore, just the runner's
# throwaway checkout copy
/release.keystore

/offlines/games/*

db.sqlite

.env
CLAUDE.md
/.claude/*
